{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "cwd": "${workspaceFolder}",
            "executable": "${command:cmake.launchTargetPath}",
            "name": "Debug with ST-Link",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none",
            "servertype": "stlink",
            "serverpath": "/opt/st/stm32cubeclt_1.19.0/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "stm32cubeprogrammer": "/opt/st/stm32cubeclt_1.19.0/STM32CubeProgrammer/bin"
        },
        {
            // =========================================================
            // HOWTO: Select Configuration to build and flash.
            // Run "CMake: Select Configure Preset" in command palette.
            // =========================================================
            "name": "OpenOCD",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "executable": "${command:cmake.launchTargetPath}",
            "request": "launch",
            "servertype": "openocd",
            "serverpath": "${config:OpenOCD.server_path}",
            "configFiles": [
                "dap.cfg"
            ],
            "serverArgs": [
                "-s",
                "${env:SCRIPTS_PATH}",
                "-d3"
            ],
            "device": "STM32F407IGHx",
            "runToEntryPoint": "main",
            "svdFile": "./extern/stm32f407.svd",
            "showDevDebugOutput": "raw",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
        },
        {
            // =========================================================
            // HOWTO: Select Test to Debug.
            // Run "CMake: Set Launch/Debug Target" in command palette.
            // =========================================================
            "name": "(ctest) Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb"
        },
    ]
}