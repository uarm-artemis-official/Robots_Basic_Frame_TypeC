CompileFlags:
  Add:
    - '-ferror-limit=0'
    - '-Wno-implicit-int'
  CompilationDatabase: build/GTest
Diagnostics:
  Suppress:
    - unused-includes
    - unknown_typename
    - unknown_typename_suggest
    - typename_requires_specqual
InlayHints:
  Enabled: 'Yes'
  ParameterNames: 'Yes'
  DeducedTypes: 'No'
